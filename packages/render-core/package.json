{
  "name": "@bragfast/render-core",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./image": {
      "types": "./dist/image-entry.d.ts",
      "require": "./dist/image-entry.js",
      "default": "./dist/image-entry.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "audit:purity": "node scripts/audit-deps.mjs"
  },
  "peerDependencies": {
    "@remotion/bundler": "4.0.448",
    "@remotion/renderer": "4.0.448",
    "react": "19.2.3",
    "remotion": "4.0.448",
    "satori": "^0.24.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.22.3"
  }
}
