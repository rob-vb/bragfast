{
  "name": "bragfast",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --workspace=packages/render-core && npm run build --workspace=packages/cli && (npx convex codegen --typecheck=disable 2>/dev/null; next build)",
    "cli:build": "npm run build --workspace=packages/cli",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "remotion:deploy": "npx tsx --env-file .env.local scripts/deploy-remotion.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@bragfast/render-core": "workspace:*",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@convex-dev/better-auth": "^0.10.13",
    "@convex-dev/stripe": "^0.1.3",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@remotion/bundler": "4.0.448",
    "@remotion/cli": "4.0.448",
    "@remotion/fonts": "4.0.448",
    "@remotion/lambda": "4.0.448",
    "@remotion/player": "4.0.448",
    "@remotion/transitions": "4.0.448",
    "better-auth": "^1.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.36.1",
    "google-auth-library": "^10.6.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "posthog-js": "^1.361.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-masonry-css": "^1.0.16",
    "remotion": "4.0.448",
    "resend": "^6.9.4",
    "satori": "^0.24.1",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "convex-test": "^0.0.50",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.0",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
